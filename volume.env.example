# Volume scan independent from the Signal radar.
# GeckoTerminal network IDs: bsc,base,eth,arbitrum (edit to desired 4 chains).
VOLUME_CHAINS=bsc,base,eth,arbitrum
VOLUME_TOP_N=25
VOLUME_TREND_DURATION=1h
MAX_TREND_PAGES=10

# Strict cap band. Candidates outside the range are skipped before alerting.
VOLUME_MIN_MARKET_CAP=500000
VOLUME_MAX_MARKET_CAP=50000000
# Unknown/unverified market cap is skipped by default to honor the max cap.
INCLUDE_UNKNOWN_MARKET_CAP=0

VOLUME_SPIKE_MIN_15M=500000
VOLUME_SPIKE_MIN_1H=1000000
VOLUME_ALERT_COOLDOWN_SECONDS=900

# A cycle runs through all configured chains, then waits 3 minutes.
CYCLE_COOLDOWN_SECONDS=180
# GeckoTerminal public docs say approximately 10 calls/min; use 8/min for headroom.
GECKO_MIN_INTERVAL_SECONDS=7.5
# DEX Screener documents up to 300 calls/min for token/pair endpoints.
DEX_MIN_INTERVAL_SECONDS=1
HTTP_TIMEOUT_SECONDS=25
RADAR_TIMEZONE=Asia/Jakarta
RADAR_LOCATION=Pemangkat

# Adjust mappings if choosing another chain. Format: logical_chain:api_chain.
GECKO_NETWORK_MAP=
DEX_CHAIN_MAP=

# Telegram destination, preferably the dedicated VOLUME topic.
TG_BOT_TOKEN=
TG_RADAR_GROUP_CHAT_ID=
TG_VOLUME_THREAD_ID=

# Optional: append/add symbols not recognized as stocks by the script.
# STOCK_TOKEN_SYMBOLS=...
